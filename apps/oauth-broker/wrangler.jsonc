{
  "name": "runelay-oauth-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "auth.runelay.com", "custom_domain": true }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0,
    "logs": { "enabled": false, "invocation_logs": false }
  },
  "logpush": false,
  "vars": {},
  "ratelimits": [
    { "name": "CALLBACK_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "TOKEN_RATE_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
  ]
}
